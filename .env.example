# Copy to .env in EACH project folder and fill in.
# Never commit .env -- .gitignore already excludes it.

LLM_PROVIDER=gemini          # gemini | groq | ollama

# gemini -- free tier, get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.0-flash

# groq -- free tier, get a key at https://console.groq.com/keys
# GROQ_API_KEY=your_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# ollama -- fully offline fallback. Run `ollama serve` first.
# OLLAMA_MODEL=llama3.1:8b

# Multilingual so Bangla and Banglish queries work.
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
